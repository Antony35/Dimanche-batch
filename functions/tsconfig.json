{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `module` et `moduleResolution` viennent de la base : ESNext + bundler.
    // C'est ce que le code EST — esbuild le bundle — et non ce qu'il devient.
    // Les décrire en CommonJS/node10 décrivait l'artefact, pas la source, et
    // node10 cesse de fonctionner en TypeScript 7.
    "noEmit": true,
    // `paths` sans `baseUrl` : les chemins sont relatifs à ce fichier.
    "paths": {
      "@dimanche-batch/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
