{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc --noEmit && node ./esbuild.config.mjs",
    "deploy": "npm run build && firebase deploy --only functions",
    "gemini:probe": "node ./esbuild.config.mjs && node .probe/probe.mjs",
    "logs": "firebase functions:log",
    "serve": "npm run build && firebase emulators:start --only functions",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@google/genai": "^1.24.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
