rules_version = '2';

/**
 * Règles de sécurité Dimanche Batch.
 *
 * Principe : le client lit, mais n'écrit presque rien. Les plans, recettes et
 * listes de courses sont produits par les Cloud Functions via l'admin SDK, qui
 * n'est pas soumis à ces règles. Ce que le client peut écrire se limite à des
 * gestes d'usage : cocher un article, mettre une recette en favori.
 *
 * Toute modification ici doit s'accompagner d'un test dans
 * `packages/rules-tests/src/firestore-rules.test.ts` (`npm run test:rules`).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isMember(householdId) {
      return isSignedIn() && request.auth.uid in householdData(householdId).members;
    }

    /** Vrai si l'écriture ne touche qu'aux champs listés. */
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /**
     * Un article de courses ajouté par le foyer, seul que le client puisse
     * créer ou supprimer. Les articles calculés portent `batch` ou `fresh` et
     * lui restent inaccessibles.
     */
    function isManualItem(data) {
      return data.origin == 'manual';
    }

    /**
     * Recopiés de `packages/shared/src/schemas/common.ts`. Les Security Rules
     * n'importent rien : c'est la seule duplication du dépôt, et elle est
     * gardée par un test qui compare les deux listes.
     */
    function unitValues() {
      return ['g', 'kg', 'ml', 'cl', 'l', 'piece', 'cas', 'cac', 'pincee', 'botte', 'gousse'];
    }

    function aisleValues() {
      return ['fruits-legumes', 'boucherie', 'poissonnerie', 'cremerie', 'boulangerie',
              'epicerie', 'surgeles', 'boissons', 'entretien', 'hygiene', 'autre'];
    }

    match /households/{householdId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.members;

      // Créer un foyer, avec soi-même pour unique membre. Ajouter un second
      // membre passe obligatoirement par la callable `joinHousehold`, qui seule
      // peut consulter un foyer dont on n'est pas encore membre.
      allow create: if isSignedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;

      // `members` est immuable côté client : on ne s'ajoute pas soi-même à un
      // foyer, et on n'en exclut pas l'autre personne.
      allow update: if isMember(householdId) && onlyChanges(['name', 'inviteCode']);

      allow delete: if false;

      match /weeklyPlans/{weekId} {
        allow read: if isMember(householdId);
        allow write: if false; // écrit uniquement par generateWeeklyPlan
      }

      match /recipes/{recipeId} {
        allow read: if isMember(householdId);
        // Les deux verdicts du foyer, et rien d'autre. Ils partent ensemble
        // parce qu'ils s'excluent : mettre en favori lève le bannissement.
        allow update: if isMember(householdId) && onlyChanges(['isFavorite', 'isDisliked']);
        allow create, delete: if false;
      }

      match /groceryLists/{weekId} {
        allow read: if isMember(householdId);
        allow write: if false;

        match /items/{itemId} {
          allow read: if isMember(householdId);
          // Cocher un article : le geste du magasin, borné à ce seul champ.
          allow update: if isMember(householdId) && onlyChanges(['checked']);

          // Ajouter et retirer un article à la main. La liste de courses est
          // celle du foyer, pas seulement celle du batch : on y met du sac
          // poubelle. Passer par une callable ajouterait un aller-retour réseau
          // au milieu d'un magasin, pour le même argument que `checked`.
          //
          // Le client est enfermé dans l'espace de noms `manual--`, et cette
          // borne est ce qui rend la règle sûre : il ne peut ni créer un faux
          // article du batch, ni supprimer un article calculé. Voir
          // `manualItemId` dans `packages/shared/src/domain/grocery.ts`.
          allow create: if isMember(householdId)
            && itemId.matches('^manual--.+')
            && isManualItem(request.resource.data)
            && request.resource.data.keys().hasOnly(
              ['name', 'qty', 'unit', 'aisle', 'checked', 'origin', 'fromRecipeIds']
            )
            && request.resource.data.keys().hasAll(
              ['name', 'qty', 'unit', 'aisle', 'checked', 'origin', 'fromRecipeIds']
            )
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.qty is number
            && request.resource.data.qty > 0
            && request.resource.data.checked is bool
            && request.resource.data.fromRecipeIds == []
            && request.resource.data.unit in unitValues()
            && request.resource.data.aisle in aisleValues();

          allow delete: if isMember(householdId) && isManualItem(resource.data);
        }
      }

      // Lexique des rayons du foyer : ce que l'utilisateur a corrigé ou ajouté
      // quand la table livrée ne connaissait pas un article. Un seul document,
      // une seule clé, et des valeurs restreintes aux rayons connus — sans quoi
      // un rayon inventé ferait disparaître l'article de la liste.
      match /lexicon/{docId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && docId == 'overrides'
          && request.resource.data.keys().hasOnly(['entries'])
          && request.resource.data.entries is map
          && request.resource.data.entries.size() <= 2000
          && request.resource.data.entries.values().hasOnly(aisleValues());
        allow delete: if false;
      }

      match /usage/{day} {
        allow read: if isMember(householdId);
        allow write: if false; // compteur de quota, géré en transaction serveur
      }

      // Verrous de génération : le client peut voir qu'une génération est en
      // cours sur l'autre téléphone, mais jamais en poser ni en lever un.
      match /locks/{weekId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }

      // Session de cuisson du dimanche : découpes et étapes composées par Gemini
      // dans une callable, donc écrites par l'admin SDK uniquement. Le client
      // les lit, rien de plus.
      match /batchSessions/{weekId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
