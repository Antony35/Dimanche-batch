{
  "name": "dimanche-batch",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "app",
    "functions",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run start -w app",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "build:shared": "npm run build -w @dimanche-batch/shared",
    "test": "npm run test -w @dimanche-batch/shared",
    "test:rules": "firebase emulators:exec --only firestore \"npm run test -w @dimanche-batch/rules-tests\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "deploy:functions": "npm run build -w functions && firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "build:android": "cd app && eas build --platform android --profile preview",
    "gemini:probe": "npm run gemini:probe -w functions --",
    "test:functions": "firebase emulators:exec --only firestore \"npm run test -w functions\"",
    "test:all": "npm run test && npm run test:functions && npm run test:rules",
    "test:coverage": "npm run test -w @dimanche-batch/shared -- --coverage.enabled"
  },
  "devDependencies": {
    "firebase-tools": "^15.30.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  }
}
