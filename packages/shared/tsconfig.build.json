{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // `node16` plutôt que l'ancien `node10`, que TypeScript 7 supprime. Le
    // package n'est pas ESM (`type` absent de son package.json), donc les
    // fichiers restent traités en CommonJS et les imports internes gardent
    // leur forme sans extension — la seule que Metro, tsc et esbuild
    // résolvent pareil. Vérifié : `tsc -p` émet bien du CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "exclude": ["src/**/*.test.ts"]
}
