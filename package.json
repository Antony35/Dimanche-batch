{
  "name": "dimanche-batch",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start -w app",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "build:shared": "npm run build -w @dimanche-batch/shared",
    "test": "npm run test -w @dimanche-batch/shared",
    "test:rules": "firebase emulators:exec --only firestore \"npm run test -w @dimanche-batch/rules-tests\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "deploy:dev": "npm run build:shared && npm run build -w functions && firebase deploy -P dev --only firestore:rules,firestore:indexes,functions",
    "deploy:prod": "npm run build:shared && npm run build -w functions && firebase deploy -P prod --only firestore:rules,firestore:indexes,functions",
    "build:android": "cd app && npx eas-cli build --platform android --profile preview",
    "build:android:prod": "cd app && npx eas-cli build --platform android --profile production",
    "gemini:probe": "npm run gemini:probe -w functions --",
    "test:functions": "firebase emulators:exec --only firestore \"npm run test -w functions\"",
    "test:all": "npm run test && npm run test:app && npm run test:functions && npm run test:rules",
    "test:coverage": "npm run test -w @dimanche-batch/shared -- --coverage.enabled",
    "test:app": "npm run test -w @dimanche-batch/app"
  },
  "devDependencies": {
    "firebase-tools": "^15.30.0",
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "archiver-utils": {
      "glob": "^13.0.6"
    },
    "exegesis": {
      "glob": "^13.0.6"
    },
    "firebase-tools": {
      "glob": "^13.0.6"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "get-uri": {
      "basic-ftp": "^6.2.3"
    },
    "rimraf": {
      "glob": "^13.0.6"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util": false,
    "@google/genai": false,
    "protobufjs": false,
    "re2": false
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
