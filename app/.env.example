# Configuration Firebase côté client.
#
# Ces valeurs ne sont PAS des secrets : elles identifient le projet et sont de
# toute façon lisibles dans le bundle. Ce qui protège les données, ce sont les
# Security Rules et l'authentification, pas la confidentialité de ces clés.
#
# La clé Gemini, elle, n'a rien à faire ici — elle vit dans Secret Manager,
# côté Cloud Functions. Voir CLAUDE.md §4.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mettre à 1 pour pointer vers la suite d'émulateurs locale (npm run emulators).
EXPO_PUBLIC_USE_EMULATORS=0
